# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Nimble web search: https://nimbleway.com/
NIMBLE_API_KEY=

# OpenWeatherMap current weather: https://home.openweathermap.org/api_keys
OPENWEATHERMAP_API_KEY=

# Gmail SMTP sender. Use a Google App Password, not your account password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Used by the blog/email projects and configurable notebook cells.
MODEL=openai/gpt-oss-20b
PROVIDER=groq